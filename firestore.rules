rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user is the owner
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Helper function to get user role from Firestore
    // Note: This requires a Firestore read, use sparingly
    function getUserRole() {
      return isAuthenticated() 
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : null;
    }
    
    // Helper function to check if user is admin
    // Uses get() to read user document - counts as a read operation
    function isAdmin() {
      return isAuthenticated() && getUserRole() == 'admin';
    }
    
    // Helper function to check if user is mentor
    function isMentor() {
      return isAuthenticated() && getUserRole() == 'mentor';
    }
    
    // Helper function to check if user is learner
    function isLearner() {
      return isAuthenticated() && getUserRole() == 'learner';
    }
    
    // ============================================
    // USERS COLLECTION
    // ============================================
    match /users/{userId} {
      // Users can read their own profile
      allow read: if isOwner(userId);
      
      // Users can update their own profile (except role and status)
      allow update: if isOwner(userId) 
        && (!('role' in request.resource.data.diff(resource.data).affectedKeys()))
        && (!('status' in request.resource.data.diff(resource.data).affectedKeys()));
      
      // Users can create their own profile during registration
      allow create: if isOwner(userId);
      
      // Only admins can delete users
      allow delete: if isAdmin();
      
      // Admins can read all users (check role from current document if accessing own profile)
      allow read: if isAdmin() || isOwner(userId);
      
      // Admins can update any user
      allow update: if isAdmin();
      
      // ============================================
      // USER ENROLLMENTS SUBCOLLECTION
      // ============================================
      match /enrollments/{enrollmentId} {
        // Users can only read/write their own enrollments
        allow read, write: if isOwner(userId);
        
        // Admins can read all enrollments
        allow read: if isAdmin();
      }
      
      // ============================================
      // USER WARDROBES SUBCOLLECTION (if exists)
      // ============================================
      match /wardrobes/{wardrobeId} {
        // Users can only access their own wardrobe
        allow read, write: if isOwner(userId);
      }
      
      // ============================================
      // ROLES SUBCOLLECTION (_roles)
      // ============================================
      match /_roles/{roleType}/{roleUserId} {
        // Admins can read/write all role documents
        allow read, write: if isAdmin();
        
        // Users can read their own role document
        allow read: if isOwner(roleUserId);
        
        // Mentors can read other mentors (for mentor list)
        allow read: if isMentor() && roleType == 'mentors';
        
        // Learners can read mentors (for mentor list)
        allow read: if isLearner() && roleType == 'mentors';
      }
    }
    
    // ============================================
    // COURSES COLLECTION
    // ============================================
    match /courses/{courseId} {
      // Anyone authenticated can read courses
      allow read: if isAuthenticated();
      
      // Only admins can create courses
      allow create: if isAdmin();
      
      // Only admins can update courses
      allow update: if isAdmin();
      
      // Only admins can delete courses
      allow delete: if isAdmin();
    }
    
    // ============================================
    // CATEGORIES COLLECTION
    // ============================================
    match /categories/{categoryId} {
      // Anyone authenticated can read categories
      allow read: if isAuthenticated();
      
      // Only admins can create/update/delete categories
      allow create, update, delete: if isAdmin();
    }
    
    // ============================================
    // DEFAULT DENY RULE
    // ============================================
    // Deny all other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

